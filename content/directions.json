{
  "facts": [
    { "term": "acromial-end-of-clavicle", "than": "sternal-end-of-clavicle", "dir": "lateral", "why": "鎖骨は胸郭上口の前で水平に横たわる。内側端（胸骨端）は太く、外側端（肩峰端）は平たい。平たい端が外側。" },
    { "term": "trapezoid-line", "than": "conoid-tubercle", "dir": "lateral", "why": "鎖骨の外側の下面で、円錐靱帯結節は後ろ寄り、菱形靱帯線はその前外側へのびる。" },
    { "term": "coracoid-process", "than": "suprascapular-notch", "dir": "anterior", "why": "烏口突起は肩甲頚から前へ突き出し、先は前外方へ曲がる。肩甲切痕はそのすぐ内側の上縁にある（『解剖学講義』）。" },
    { "term": "superior-angle-of-scapula", "than": "inferior-angle-of-scapula", "dir": "superior", "why": "肩甲骨は逆三角形。上角は第2肋骨、下角は第7肋骨（第7胸椎の棘突起）の高さ。" },
    { "term": "medial-border-of-scapula", "than": "lateral-border-of-scapula", "dir": "medial", "why": "内側縁は脊柱にほぼ平行に走る。外側縁は腋窩の側。" },
    { "term": "supraspinous-fossa", "than": "infraspinous-fossa", "dir": "superior", "why": "後面の上1/3を肩甲棘が横に走り、上が棘上窩、下が棘下窩。" },
    { "term": "supraglenoid-tubercle", "than": "infraglenoid-tubercle", "dir": "superior", "why": "関節窩の上に関節上結節（上腕二頭筋の長頭）、下に関節下結節（上腕三頭筋の長頭）。" },
    { "term": "head-of-humerus", "than": "greater-tubercle", "dir": "medial", "why": "上腕骨頭は内側（やや後ろ上）を向いて関節窩にはまる。大結節は頭の外側（後外側）にある。左右の見分けは「骨頭が内側」。" },
    { "term": "surgical-neck", "than": "anatomical-neck", "dir": "inferior", "why": "解剖頚は頭のすぐ根もと、外科頚は大結節・小結節のすぐ下。骨折しやすいのは外科頚。" },
    { "term": "deltoid-tuberosity", "than": "head-of-humerus", "dir": "inferior", "why": "三角筋粗面は上腕骨体のほぼ中央の外側にある。" },
    { "term": "medial-epicondyle-of-humerus", "than": "lateral-epicondyle-of-humerus", "dir": "medial", "why": "下端の両わきの突起。内側上顆の方が大きく、後面に尺骨神経溝が走る。" },
    { "term": "capitulum-of-humerus", "than": "trochlea-of-humerus", "dir": "lateral", "why": "上腕骨顆の外側1/3が小頭（橈骨と関節）、内側2/3が滑車（尺骨と関節）。" },
    { "term": "radial-fossa", "than": "coronoid-fossa", "dir": "lateral", "why": "前面で、小頭の上に橈骨窩、滑車の上に鈎突窩。後面の大きなくぼみは肘頭窩。" },
    { "term": "radius", "than": "ulna", "dir": "lateral", "why": "解剖学的正位（手のひらが前）では、橈骨は母指側＝外側、尺骨は小指側＝内側。" },
    { "term": "radial-tuberosity", "than": "head-of-radius", "dir": "inferior", "why": "橈骨頭の下が細い橈骨頚、そのすぐ下の前内側に橈骨粗面（上腕二頭筋が付く）。" },
    { "term": "radial-styloid-process", "than": "ulnar-notch-of-radius", "dir": "lateral", "why": "橈骨の下端は太く、外側に茎状突起、内側に尺骨頭を受ける尺骨切痕。" },
    { "term": "ulnar-styloid-process", "than": "radial-styloid-process", "dir": "medial", "why": "尺骨の茎状突起は手首の小指側、橈骨の茎状突起は母指側。橈骨の方が約1横指遠位にある（『解剖学講義』）。" },
    { "term": "olecranon", "than": "coronoid-process-of-ulna", "dir": "posterior", "why": "尺骨の上端はスパナの形。後ろが肘頭、前が鈎状突起で、その間が滑車切痕。" },
    { "term": "ulnar-tuberosity", "than": "coronoid-process-of-ulna", "dir": "inferior", "why": "鈎状突起のすぐ遠位に尺骨粗面（上腕筋が付く）。" },
    { "term": "head-of-ulna", "than": "olecranon", "dir": "inferior", "why": "尺骨は上端が太く（肘頭）、下端が細い（尺骨頭）。橈骨はその逆で、下端が太い。" },
    { "term": "scaphoid", "than": "lunate", "dir": "lateral", "why": "手根骨の近位列は、母指側から舟状骨・月状骨・三角骨・豆状骨。" },
    { "term": "pisiform", "than": "triquetrum", "dir": "anterior", "why": "豆状骨は三角骨の掌側に乗る種子骨（尺側手根屈筋の腱の中）。" },
    { "term": "hamate", "than": "capitate", "dir": "medial", "why": "遠位列は母指側から大菱形骨・小菱形骨・有頭骨・有鈎骨。有鈎骨は小指側。" },
    { "term": "hook-of-hamate", "than": "hamate", "dir": "anterior", "why": "有鈎骨鈎は掌側に突き出し、豆状骨とともに内側手根隆起をつくる。" },
    { "term": "first-metacarpal", "than": "fifth-metacarpal", "dir": "lateral", "why": "中手骨は母指側から第1〜5。解剖学的正位では母指が外側。" },
    { "term": "iliac-crest", "than": "acetabulum", "dir": "superior", "why": "寛骨の上半部が腸骨で、上縁が腸骨稜。寛骨臼は外側面の中央で、前外下方を向く。" },
    { "term": "anterior-superior-iliac-spine", "than": "posterior-superior-iliac-spine", "dir": "anterior", "why": "腸骨稜の前端が上前腸骨棘、後端が上後腸骨棘。" },
    { "term": "anterior-inferior-iliac-spine", "than": "anterior-superior-iliac-spine", "dir": "inferior", "why": "上前腸骨棘の下に下前腸骨棘（大腿直筋が起こる）。" },
    { "term": "posterior-superior-iliac-spine", "than": "posterior-inferior-iliac-spine", "dir": "superior", "why": "上後腸骨棘の下に下後腸骨棘、その下に大坐骨切痕。" },
    { "term": "greater-sciatic-notch", "than": "lesser-sciatic-notch", "dir": "superior", "why": "坐骨棘の上が大坐骨切痕、下が小坐骨切痕（『解剖学講義』）。" },
    { "term": "ischial-tuberosity", "than": "ischial-spine", "dir": "inferior", "why": "坐骨の後縁に坐骨棘、下端に大きな坐骨結節（座ると椅子に当たる）。" },
    { "term": "obturator-foramen", "than": "acetabulum", "dir": "inferior", "why": "閉鎖孔は寛骨の前下部の大きな孔。前が恥骨、後ろが坐骨。" },
    { "term": "head-of-femur", "than": "greater-trochanter", "dir": "medial", "why": "大腿骨頭は内上方（やや前）を向いて寛骨臼にはまる。大転子は外上側の隆起。" },
    { "term": "trochanteric-fossa", "than": "greater-trochanter", "dir": "medial", "why": "大転子の基部の内側に転子窩。" },
    { "term": "intertrochanteric-line", "than": "intertrochanteric-crest", "dir": "anterior", "why": "大転子と小転子の間を、前は転子間線、後ろは転子間稜が結ぶ。" },
    { "term": "intercondylar-fossa", "than": "patellar-surface", "dir": "posterior", "why": "内側顆と外側顆は、前では膝蓋面でつながり、後ろでは深い顆間窩で隔てられる。" },
    { "term": "medial-condyle-of-femur", "than": "lateral-condyle-of-femur", "dir": "medial", "why": "大腿骨の下端は内・外の顆に分かれる。顆が見えている側が後面。" },
    { "term": "medial-epicondyle-of-femur", "than": "lateral-epicondyle-of-femur", "dir": "medial", "why": "内側顆・外側顆がそれぞれ側方に突き出して上顆になる。" },
    { "term": "adductor-tubercle", "than": "medial-epicondyle-of-femur", "dir": "superior", "why": "内側上顆の上端に内転筋結節（大内転筋が付く）。" },
    { "term": "apex-of-patella", "than": "base-of-patella", "dir": "inferior", "why": "膝蓋骨は逆三角形。広い上縁が底、とがった先が下を向いて尖。" },
    { "term": "medial-condyle-of-tibia", "than": "lateral-condyle-of-tibia", "dir": "medial", "why": "脛骨の上端は左右に広がり、内側顆と外側顆になる。" },
    { "term": "medial-intercondylar-tubercle", "than": "lateral-intercondylar-tubercle", "dir": "medial", "why": "2つの上関節面の間の顆間隆起は、内側・外側の顆間結節に分かれる。" },
    { "term": "anterior-intercondylar-area", "than": "posterior-intercondylar-area", "dir": "anterior", "why": "顆間隆起の前が前顆間区（前十字靱帯）、後ろが後顆間区（後十字靱帯）。" },
    { "term": "fibular-articular-facet", "than": "medial-condyle-of-tibia", "dir": "lateral", "why": "外側顆の後外下側に腓骨頭との関節面がある。" },
    { "term": "fibula", "than": "tibia", "dir": "lateral", "why": "下腿の内側に太い脛骨、外側に細い腓骨。腓骨はやや後ろ（後外側）にある。" },
    { "term": "medial-malleolus", "than": "fibular-notch", "dir": "medial", "why": "脛骨の下端の内側が下へ突き出して内果、外側のくぼみが腓骨の下端を受ける腓骨切痕。" },
    { "term": "lateral-malleolus", "than": "medial-malleolus", "dir": "lateral", "why": "外果は腓骨、内果は脛骨。外果は内果より1〜2cm遠位で、やや後ろにある（『解剖学講義』）。" },
    { "term": "talus", "than": "calcaneus", "dir": "superior", "why": "距骨と踵骨は上下に重なって体重を支える。踵骨の上に距骨が載る。" },
    { "term": "head-of-talus", "than": "posterior-process-of-talus", "dir": "anterior", "why": "距骨は前から頭・頚・体。頭は前へ丸く突き出し、舟状骨と関節する。" },
    { "term": "sustentaculum-tali", "than": "fibular-trochlea", "dir": "medial", "why": "載距突起は踵骨の内側へ棚のように突き出して距骨を載せる。腓骨筋滑車は外側面。" },
    { "term": "calcaneal-tuberosity", "than": "anterior-talar-articular-surface", "dir": "posterior", "why": "踵骨の後ろ1/3が後下方へ突き出して踵骨隆起（かかと）。" },
    { "term": "medial-cuneiform", "than": "lateral-cuneiform", "dir": "medial", "why": "3つの楔状骨は舟状骨の前に、内側から内側・中間・外側の順に並ぶ。" },
    { "term": "spinous-process", "than": "vertebral-body", "dir": "posterior", "why": "椎骨は前の椎体と後ろの椎弓からなり、椎弓から後ろへ棘突起が出る。" },
    { "term": "superior-articular-process", "than": "inferior-articular-process", "dir": "superior", "why": "椎弓から上下に関節突起が出て、上の椎骨の下関節突起と下の椎骨の上関節突起が椎間関節をつくる。" },
    { "term": "anterior-tubercle-of-atlas", "than": "posterior-tubercle-of-atlas", "dir": "anterior", "why": "環椎は前弓と後弓の輪。前弓の前に前結節、後弓の後ろに後結節。" },
    { "term": "dens-of-axis", "than": "axis", "dir": "superior", "why": "軸椎の椎体から上へ歯突起が立ち、環椎の前弓の後ろの歯突起窩と関節する。" },
    { "term": "base-of-sacrum", "than": "apex-of-sacrum", "dir": "superior", "why": "仙骨は逆三角形。上の広い所が底、下のとがった所が尖（尾骨とつながる）。" },
    { "term": "posterior-sacral-foramina", "than": "anterior-sacral-foramina", "dir": "posterior", "why": "仙骨の前面（骨盤面）に前仙骨孔、後面に後仙骨孔。後面はざらざらで、稜が縦に走る。" },
    { "term": "xiphoid-process", "than": "manubrium", "dir": "inferior", "why": "胸骨は上から胸骨柄・胸骨体・剣状突起。" },
    { "term": "angle-of-rib", "than": "tubercle-of-rib", "dir": "lateral", "why": "肋骨は後ろから頭・頚・結節と続き、結節の外側で前へ強く曲がる所が肋骨角。" },
    { "term": "external-occipital-protuberance", "than": "nasion", "dir": "posterior", "why": "ナジオンは鼻根の前頭鼻骨縫合の正中点、外後頭隆起は後頭部の正中の高まり。" },
    { "term": "foramen-magnum", "than": "external-occipital-protuberance", "dir": "anterior", "why": "大後頭孔は頭蓋底の後頭骨にあり、外後頭隆起はその後ろ上。" },
    { "term": "infra-orbital-foramen", "than": "supra-orbital-foramen", "dir": "inferior", "why": "眼窩の上縁に眼窩上孔（前頭骨）、下縁の下に眼窩下孔（上顎骨）。" },
    { "term": "zygomatic-arch", "than": "external-acoustic-opening", "dir": "anterior", "why": "頬骨弓は外耳孔の前から頬へのびる。" },
    { "term": "mastoid-process", "than": "external-acoustic-opening", "dir": "posterior", "why": "乳様突起は外耳孔の後ろ下にあり、耳の後ろで触れる。" },
    { "term": "styloid-process-of-temporal-bone", "than": "mastoid-process", "dir": "anterior", "why": "茎状突起は乳様突起の前内側から前下方へ細くのびる。間に茎乳突孔（顔面神経）。" },
    { "term": "head-of-mandible", "than": "coronoid-process-of-mandible", "dir": "posterior", "why": "下顎枝の上は、後ろの関節突起（下顎頭）と前の筋突起に分かれ、間が下顎切痕。" },
    { "term": "angle-of-mandible", "than": "mental-protuberance", "dir": "posterior", "why": "下顎体の前の正中にオトガイ隆起、後ろの下顎体と下顎枝の境が下顎角。" }
  ]
}
